# Copiar a deploy/secrets.env con los valores reales (secrets.env está en .gitignore
# y NUNCA debe commitearse). Luego subirlo al VPS:
#   scp deploy/secrets.env root@212.85.0.138:/root/rueda_secrets.env

# Contraseña del usuario "rueda" de PostgreSQL en el VPS (inventar una fuerte)
DB_PASS=cambiar_por_una_clave_fuerte

# Secreto para firmar JWT (inventar uno largo y aleatorio)
JWT_SECRET=cambiar_por_un_secreto_largo

# Credenciales del correo que envía notificaciones (contraseña de aplicación de Gmail)
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=clave_de_aplicacion_gmail
MAIL_FROM="Rueda de Negocios <tu_correo@gmail.com>"
